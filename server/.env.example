# Copy to server/.env and fill in. NEVER commit server/.env.

NODE_ENV=development
PORT=4000

# ---- MySQL -------------------------------------------------------------------
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your-mysql-password@localhost:3306/saferent"

# ---- Web app origin (CORS) ----------------------------------------------------
APP_ORIGIN=http://localhost:5173

# ---- Firebase (authentication only) -------------------------------------------
FIREBASE_PROJECT_ID=saferent-768a3
# Firebase console → Project settings → Service accounts → Generate new private key.
# Save the file as server/service-account.json (already git-ignored).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---- OTP secret ---------------------------------------------------------------
# Generate with:  openssl rand -base64 48
OTP_PEPPER=replace-with-a-long-random-secret-at-least-32-characters

# ---- Email --------------------------------------------------------------------
# console = print emails (OTP codes) in this terminal  |  smtp = send real emails
EMAIL_PROVIDER=console
EMAIL_FROM="SafeRent Security <security@saferenttechnologies.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Payments ----------------------------------------------------------------
# test     = "Pay rent" marks rent as paid instantly, clearly flagged TEST (development only — no money moves)
# disabled = no online payment; finance records offline collections
# Integrate a real payment gateway (e.g. Razorpay) before accepting real payments.
PAYMENT_MODE=test

# ─── Wallet top-ups (payment gateways) ───
# Get keys from the Razorpay Dashboard → Settings → API Keys (rzp_test_… for testing).
# Then switch Razorpay ON in Admin → Payment gateways. The secret never leaves the server.
# Webhook: Dashboard → Webhooks → URL https://<your-api>/api/v1/webhooks/razorpay,
# events payment.captured, payment.failed, order.paid, with the secret below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Paytm / Instamojo checkout is not wired yet (keys can be added later).
PAYTM_MID=
PAYTM_MERCHANT_KEY=
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=

# ---- Owner verification (DigiLocker via Setu) -----------------------------------
# Keys from Setu (DigiLocker product). Leave empty in development to use the fake "mock" DigiLocker.
# KYC_PROVIDER=setu|mock|off  (mock is refused in production)
KYC_PROVIDER=
SETU_DG_CLIENT_ID=
SETU_DG_CLIENT_SECRET=
SETU_DG_PRODUCT_INSTANCE_ID=
SETU_DG_SANDBOX=true

# ---- Production hardening -----------------------------------------------------
APP_CHECK_ENFORCE=false
TRUST_PROXY=0

# ---- API docs -----------------------------------------------------------------
# Swagger UI at /api/v1/docs and the spec at /api/v1/openapi.json (default: on, except NODE_ENV=production)
# API_DOCS=true

# ---- Integration tests ----------------------------------------------------------
# A SEPARATE, empty database used by `npm --prefix server run test:integration` (it is wiped on every run).
# Create it first:  mysql -u root -p -e "CREATE DATABASE saferent_test;"   then:  npm --prefix server run test:migrate
# TEST_DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/saferent_test"

