# Copy to server/.env and fill in. NEVER commit server/.env.

NODE_ENV=development
PORT=4000

# ---- MySQL -------------------------------------------------------------------
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:your-mysql-password@localhost:3306/saferent"

# ---- Web app origin (CORS) ----------------------------------------------------
APP_ORIGIN=http://localhost:5173

# ---- Firebase (authentication only) -------------------------------------------
FIREBASE_PROJECT_ID=saferent-768a3
# Firebase console → Project settings → Service accounts → Generate new private key.
# Save the file as server/service-account.json (already git-ignored).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---- OTP secret ---------------------------------------------------------------
# Generate with:  openssl rand -base64 48
OTP_PEPPER=replace-with-a-long-random-secret-at-least-32-characters

# ---- Email --------------------------------------------------------------------
# console = print emails (OTP codes) in this terminal  |  smtp = send real emails
EMAIL_PROVIDER=console
EMAIL_FROM="SafeRent Security <security@saferenttechnologies.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- Payments ----------------------------------------------------------------
# test     = "Pay rent" marks rent as paid instantly, clearly flagged TEST (development only — no money moves)
# disabled = no online payment; finance records offline collections
# Integrate a real payment gateway (e.g. Razorpay) before accepting real payments.
PAYMENT_MODE=test

# ---- Production hardening -----------------------------------------------------
APP_CHECK_ENFORCE=false
TRUST_PROXY=0
