/// Rent and financial terms for the whole property (scope_key = "PROPERTY") or one unit (scope_key = unit id).
model PropertyPricing {
  id                     String          @id @default(uuid()) @db.Char(36)
  propertyId             String          @map("property_id") @db.Char(36)
  unitId                 String?         @map("unit_id") @db.Char(36)
  scopeKey               String          @map("scope_key") @db.VarChar(36)
  currency               String          @default("INR") @db.Char(3)
  monthlyRent            Decimal?        @map("monthly_rent") @db.Decimal(12, 2)
  salePrice              Decimal?        @map("sale_price") @db.Decimal(14, 2)
  securityDeposit        Decimal?        @map("security_deposit") @db.Decimal(12, 2)
  advanceRentMonths      Int?            @map("advance_rent_months")
  rentDueDay             Int?            @map("rent_due_day")
  lateFeePolicy          String?         @map("late_fee_policy") @db.VarChar(500)
  lockInPeriodMonths     Int?            @map("lock_in_period_months")
  noticePeriodDays       Int?            @map("notice_period_days")
  rentIncreasePolicy     String?         @map("rent_increase_policy") @db.VarChar(500)
  agreementCharges       Decimal?        @map("agreement_charges") @db.Decimal(12, 2)
