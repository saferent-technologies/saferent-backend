model Lease {
  id              String      @id @default(uuid()) @db.Char(36)
  code            String?     @unique @db.VarChar(20)
  propertyId      String      @map("property_id") @db.Char(36)
  unitId          String?     @map("unit_id") @db.Char(36)
  bedId           String?     @map("bed_id") @db.Char(36)
  landlordId      String      @map("landlord_id") @db.Char(36)
  tenantId        String      @map("tenant_id") @db.Char(36)
  applicationId   String?     @unique @map("application_id") @db.Char(36)
  startDate       DateTime    @map("start_date") @db.Date
  endDate         DateTime    @map("end_date") @db.Date
  monthlyRent     Decimal     @map("monthly_rent") @db.Decimal(12, 2)
  securityDeposit Decimal     @map("security_deposit") @db.Decimal(12, 2)
  rentDueDay      Int         @default(5) @map("rent_due_day")
  maintenanceCharges Decimal? @map("maintenance_charges") @db.Decimal(12, 2)
  noticePeriodDays   Int?     @map("notice_period_days")
  lockInMonths       Int?     @map("lock_in_months")
  /// Set when the lease was created by a tenant accepting an invitation link.
  invitationId       String?  @unique @map("invitation_id") @db.Char(36)
  terms           String?     @db.Text
  status          LeaseStatus @default(ACTIVE)
  endedAt         DateTime?   @map("ended_at")
  createdById     String      @map("created_by_id") @db.Char(36)
  createdAt       DateTime    @default(now()) @map("created_at")

  property     Property           @relation(fields: [propertyId], references: [id])
  unit         PropertyUnit?      @relation(fields: [unitId], references: [id])
  landlord     User               @relation("LeaseLandlord", fields: [landlordId], references: [id])
  tenant       User               @relation("LeaseTenant", fields: [tenantId], references: [id])
  application  RentalApplication? @relation(fields: [applicationId], references: [id])
  rentPayments RentPayment[]
  reviews      RentalReview[]
  exitRequests LeaseExitRequest[]
  panShare     PanShareRequest?

  @@index([tenantId, status])
  @@index([landlordId, status])
  @@index([propertyId, status])
  @@map("leases")
}

/// Landlord → tenant invitation link. Only the SHA-256 of the token is stored; the token itself is shown
/// to the landlord once (when the link is made). Single-use, expiring and revocable.
model TenantInvitation {
  id                 String           @id @default(uuid()) @db.Char(36)
  code               String           @unique @db.VarChar(20)
  tokenHash          String           @unique @map("token_hash") @db.Char(64)
  propertyId         String           @map("property_id") @db.Char(36)
  unitId             String?          @map("unit_id") @db.Char(36)
  bedId              String?          @map("bed_id") @db.Char(36)
  landlordId         String           @map("landlord_id") @db.Char(36)
  createdById        String           @map("created_by_id") @db.Char(36)
  recipientName      String           @map("recipient_name") @db.VarChar(120)
  recipientPhone     String?          @map("recipient_phone") @db.VarChar(20)
  recipientEmail     String?          @map("recipient_email") @db.VarChar(254)
  monthlyRent        Decimal          @map("monthly_rent") @db.Decimal(12, 2)
  securityDeposit    Decimal          @map("security_deposit") @db.Decimal(12, 2)
  maintenanceCharges Decimal?         @map("maintenance_charges") @db.Decimal(12, 2)
  /// [{ label, amount }]
  otherCharges       Json?            @map("other_charges")
  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime?        @map("end_date") @db.Date
  rentDueDay         Int              @map("rent_due_day")
  noticePeriodDays   Int?             @map("notice_period_days")
  lockInMonths       Int?             @map("lock_in_months")
  additionalTerms    String?          @map("additional_terms") @db.Text
  status             InvitationStatus @default(PENDING)
  expiresAt          DateTime         @map("expires_at")
  respondedById      String?          @map("responded_by_id") @db.Char(36)
  respondedAt        DateTime?        @map("responded_at")
  revokedById        String?          @map("revoked_by_id") @db.Char(36)
  leaseId            String?          @unique @map("lease_id") @db.Char(36)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([landlordId, status])
  @@index([unitId, status])
  @@index([bedId, status])
  @@map("tenant_invitations")
}

/// Two-way, double-blind review of a finished lease. One per reviewer per lease (unique below).
model RentalReview {
  id              String             @id @default(uuid()) @db.Char(36)
  code            String             @unique @db.VarChar(20)
  leaseId         String             @map("lease_id") @db.Char(36)
  propertyId      String             @map("property_id") @db.Char(36)
  unitId          String?            @map("unit_id") @db.Char(36)
  bedId           String?            @map("bed_id") @db.Char(36)
  landlordId      String             @map("landlord_id") @db.Char(36)
  tenantId        String             @map("tenant_id") @db.Char(36)
  reviewerId      String             @map("reviewer_id") @db.Char(36)
  reviewerRole    ReviewerRole       @map("reviewer_role")
  revieweeId      String             @map("reviewee_id") @db.Char(36)
  revieweeRole    ReviewerRole       @map("reviewee_role")
  overallRating   Int                @map("overall_rating")
  categoryRatings Json               @map("category_ratings")
  reviewText      String?            @map("review_text") @db.Text
  tags            Json?
  /// Optional evidence, e.g. { inspectionIds: [...] } — only inspections of this lease.
  evidence        Json?
  status          RentalReviewStatus @default(SUBMITTED)
  submittedAt     DateTime           @default(now()) @map("submitted_at")
  publishedAt     DateTime?          @map("published_at")
  responseText    String?            @map("response_text") @db.Text
  respondedAt     DateTime?          @map("responded_at")
  responseEditedAt DateTime?         @map("response_edited_at")
  responseHidden  Boolean            @default(false) @map("response_hidden")
  moderationNote  String?            @map("moderation_note") @db.VarChar(500)
  updatedAt       DateTime           @updatedAt @map("updated_at")

  lease    Lease                 @relation(fields: [leaseId], references: [id])
  property Property              @relation(fields: [propertyId], references: [id])
  reports  ReviewReport[]
  logs     ReviewModerationLog[]

  @@unique([leaseId, reviewerId])
  @@index([revieweeId, status])
  @@index([propertyId, status])
  @@index([unitId, status])
  @@index([status, submittedAt])
  @@map("rental_reviews")
}

model ReviewReport {
  id           String             @id @default(uuid()) @db.Char(36)
  reviewId     String             @map("review_id") @db.Char(36)
  reportedById String             @map("reported_by_id") @db.Char(36)
  reason       ReviewReportReason
  description  String?            @db.VarChar(1000)
  status       ReviewReportStatus @default(OPEN)
  reviewedById String?            @map("reviewed_by_id") @db.Char(36)
  resolution   String?            @db.VarChar(500)
  createdAt    DateTime           @default(now()) @map("created_at")
  resolvedAt   DateTime?          @map("resolved_at")

  review RentalReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reportedById])
  @@index([status, createdAt])
  @@map("review_reports")
}

/// Append-only history of every moderation action (who, what, why).
model ReviewModerationLog {
  id          String   @id @default(uuid()) @db.Char(36)
  reviewId    String   @map("review_id") @db.Char(36)
  action      String   @db.VarChar(40)
  fromStatus  String?  @map("from_status") @db.VarChar(20)
  toStatus    String?  @map("to_status") @db.VarChar(20)
  reason      String   @db.VarChar(500)
  moderatorId String   @map("moderator_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")

  review RentalReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@map("review_moderation_logs")
}

/// One shareable code per user per kind. Revoking makes a new code; old links stop working.
model ReferralCode {
  id        String             @id @default(uuid()) @db.Char(36)
  code      String             @unique @db.VarChar(20)
  userId    String             @map("user_id") @db.Char(36)
  kind      ReferralCodeKind
  status    ReferralCodeStatus @default(ACTIVE)
  expiresAt DateTime?          @map("expires_at")
  opens     Int                @default(0)
  createdAt DateTime           @default(now()) @map("created_at")
  revokedAt DateTime?          @map("revoked_at")

  referrals Referral[]

  @@index([userId, kind, status])
  @@map("referral_codes")
}

/// One referral = one referrer + one referred person + one type. Unique per (type, referred user):
/// a person can make only one referrer earn for the same kind of event, ever.
model Referral {
  id              String         @id @default(uuid()) @db.Char(36)
  code            String         @unique @db.VarChar(20)
  type            ReferralType
  referrerId      String         @map("referrer_id") @db.Char(36)
  referredUserId  String         @map("referred_user_id") @db.Char(36)
  referralCodeId  String?        @map("referral_code_id") @db.Char(36)
  invitationId    String?        @unique @map("invitation_id") @db.Char(36)
  leaseId         String?        @map("lease_id") @db.Char(36)
  status          ReferralStatus @default(REGISTERED)
  rewardStatus    RewardStatus   @default(NOT_DUE) @map("reward_status")
  onHold          Boolean        @default(false) @map("on_hold")
  holdReason      String?        @map("hold_reason") @db.VarChar(500)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(500)
  eligibleAt      DateTime?      @map("eligible_at")
  successfulAt    DateTime?      @map("successful_at")
  rewardedAt      DateTime?      @map("rewarded_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  referralCode ReferralCode?           @relation(fields: [referralCodeId], references: [id])
  events       ReferralEvent[]
  entitlement  SubscriptionEntitlement?

  @@unique([type, referredUserId])
  @@index([referrerId, type, status])
  @@index([status, rewardStatus])
  @@map("referrals")
}

/// Append-only history of every referral step and admin action.
model ReferralEvent {
  id         String   @id @default(uuid()) @db.Char(36)
  referralId String?  @map("referral_id") @db.Char(36)
  codeId     String?  @map("code_id") @db.Char(36)
  event      String   @db.VarChar(40)
  data       Json?
  actorId    String?  @map("actor_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")

  referral Referral? @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId, createdAt])
  @@index([event, createdAt])
  @@map("referral_events")
}

model ReferralCampaign {
  type              ReferralType @id
  enabled           Boolean      @default(true)
  rewardAmount      Decimal?     @map("reward_amount") @db.Decimal(10, 2)
  durationMonths    Int?         @map("duration_months")
  maxRewardsPerUser Int?         @map("max_rewards_per_user")
  startsAt          DateTime?    @map("starts_at")
  endsAt            DateTime?    @map("ends_at")
  codeExpiryDays    Int?         @map("code_expiry_days")
  rewardExpiryDays  Int?         @map("reward_expiry_days")
  tenantEligibility String?      @map("tenant_eligibility") @db.VarChar(30)
  terms             String?      @db.Text
  updatedById       String?      @map("updated_by_id") @db.Char(36)
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("referral_campaigns")
}

/// Promotional credit balance — not cash: no withdrawal, no transfer, not usable for rent.
/// The balance only ever changes together with a ledger row (same transaction).
model PromoWallet {
  userId         String   @id @map("user_id") @db.Char(36)
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  /// Money added through payment gateways (separate from promotional credit).
  cashBalance    Decimal  @default(0) @map("cash_balance") @db.Decimal(12, 2)
  lifetimeEarned Decimal  @default(0) @map("lifetime_earned") @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("promo_wallets")
}

model PromoWalletTransaction {
  id             String        @id @default(uuid()) @db.Char(36)
  userId         String        @map("user_id") @db.Char(36)
  type           WalletTxnType
  bucket         WalletBucket  @default(PROMO)
  /// + credit / − debit
  amount         Decimal       @db.Decimal(12, 2)
  balanceAfter   Decimal       @map("balance_after") @db.Decimal(12, 2)
  currency       String        @default("INR") @db.Char(3)
  status         String        @default("CREDITED") @db.VarChar(20)
  rewardType     String?       @map("reward_type") @db.VarChar(30)
  referralId     String?       @map("referral_id") @db.Char(36)
  /// Credits only: what is left to spend (oldest-expiring spent first).
  remaining      Decimal?      @db.Decimal(12, 2)
  expiresAt      DateTime?     @map("expires_at")
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(80)
  note           String?       @db.VarChar(255)
  createdById    String?       @map("created_by_id") @db.Char(36)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, type, expiresAt])
  @@map("promo_wallet_transactions")
}

/// Free subscription time granted by a referral (never cash).
model SubscriptionEntitlement {
  id             String            @id @default(uuid()) @db.Char(36)
  userId         String            @map("user_id") @db.Char(36)
  planId         String            @map("plan_id") @db.Char(36)
  planName       String            @map("plan_name") @db.VarChar(60)
  months         Int
  referralId     String            @unique @map("referral_id") @db.Char(36)
  subscriptionId String?           @unique @map("subscription_id") @db.Char(36)
  status         EntitlementStatus
  startsAt       DateTime?         @map("starts_at")
  endsAt         DateTime?         @map("ends_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  referral Referral @relation(fields: [referralId], references: [id])

  @@index([userId, status])
  @@map("subscription_entitlements")
}

/// Mutual lease close: one side asks (with reason + move-out date), the other must accept. Only one open
/// request per lease (open_lease_id is set to the lease id while PENDING / ACCEPTED, else NULL).
model LeaseExitRequest {
  id              String          @id @default(uuid()) @db.Char(36)
  leaseId         String          @map("lease_id") @db.Char(36)
  openLeaseId     String?         @unique @map("open_lease_id") @db.Char(36)
  requestedById   String          @map("requested_by_id") @db.Char(36)
  requestedByRole ReviewerRole    @map("requested_by_role")
  reason          String          @db.Text
  moveOutDate     DateTime        @map("move_out_date") @db.Date
  status          LeaseExitStatus @default(PENDING)
  respondedById   String?         @map("responded_by_id") @db.Char(36)
  respondedAt     DateTime?       @map("responded_at")
  responseNote    String?         @map("response_note") @db.VarChar(1000)
  /// Optional reviews written while asking / accepting; submitted automatically once the lease closes.
  requesterReview Json?           @map("requester_review")
  responderReview Json?           @map("responder_review")
  completedAt     DateTime?       @map("completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  lease Lease @relation(fields: [leaseId], references: [id])

  @@index([leaseId, createdAt])
  @@index([status, moveOutDate])
  @@map("lease_exit_requests")
}

/// Payment gateways the admin can switch on. Secrets never live here — only in server/.env.
model PaymentGateway {
  provider    PaymentProvider @id
  enabled     Boolean         @default(false)
  minAmount   Decimal         @default(10) @map("min_amount") @db.Decimal(10, 2)
  maxAmount   Decimal         @default(10000) @map("max_amount") @db.Decimal(10, 2)
  updatedById String?         @map("updated_by_id") @db.Char(36)
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("payment_gateways")
}

/// One "add money to wallet" attempt. Credited only after the gateway confirms (signature + API check
/// or signed webhook) — never because the app says it succeeded.
model WalletTopup {
  id                String          @id @default(uuid()) @db.Char(36)
  code              String          @unique @db.VarChar(20)
  userId            String          @map("user_id") @db.Char(36)
  provider          PaymentProvider
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR") @db.Char(3)
  status            TopupStatus     @default(CREATED)
  providerOrderId   String?         @unique @map("provider_order_id") @db.VarChar(64)
  providerPaymentId String?         @unique @map("provider_payment_id") @db.VarChar(64)
  method            String?         @db.VarChar(30)
  failureReason     String?         @map("failure_reason") @db.VarChar(255)
  testMode          Boolean         @default(false) @map("test_mode")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  paidAt            DateTime?       @map("paid_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("wallet_topups")
}

// ───────────────────────────── Finance ─────────────────────────────

model RentPayment {
  id            String     @id @default(uuid()) @db.Char(36)
  leaseId       String     @map("lease_id") @db.Char(36)
  propertyId    String     @map("property_id") @db.Char(36)
  tenantId      String     @map("tenant_id") @db.Char(36)
  landlordId    String     @map("landlord_id") @db.Char(36)
  period        String     @db.Char(7) // YYYY-MM
  amount        Decimal    @db.Decimal(12, 2)
  dueDate       DateTime   @map("due_date") @db.Date
  status        RentStatus @default(DUE)
  paidAt        DateTime?  @map("paid_at")
  method        String?    @db.VarChar(30)
  receiptNumber String?    @unique @map("receipt_number") @db.VarChar(40)
  recordedById  String?    @map("recorded_by_id") @db.Char(36)
  createdAt     DateTime   @default(now()) @map("created_at")

  lease        Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([leaseId, period])
  @@index([tenantId, status])
  @@index([landlordId, status])
  @@map("rent_payments")
}

model Transaction {
  id             String            @id @default(uuid()) @db.Char(36)
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  amount         Decimal           @db.Decimal(12, 2)
  payerId        String?           @map("payer_id") @db.Char(36)
  payeeId        String?           @map("payee_id") @db.Char(36)
  propertyId     String?           @map("property_id") @db.Char(36)
  rentPaymentId  String?           @map("rent_payment_id") @db.Char(36)
  invoiceId      String?           @map("invoice_id") @db.Char(36)
  method         String            @db.VarChar(30)
  reference      String            @unique @db.VarChar(60)
  notes          String?           @db.VarChar(500)
  isTest         Boolean           @default(false) @map("is_test")
  reconciled     Boolean           @default(false)
  reconciledById String?           @map("reconciled_by_id") @db.Char(36)
  reconciledAt   DateTime?         @map("reconciled_at")
  createdById    String?           @map("created_by_id") @db.Char(36)
  createdAt      DateTime          @default(now()) @map("created_at")

  rentPayment RentPayment? @relation(fields: [rentPaymentId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  refunds     Refund[]

  @@index([type, status, createdAt])
  @@index([payerId])
  @@index([payeeId])
  @@map("transactions")
}

model Invoice {
  id          String        @id @default(uuid()) @db.Char(36)
  number      String        @unique @db.VarChar(30)
  issuedToId  String        @map("issued_to_id") @db.Char(36)
  propertyId  String?       @map("property_id") @db.Char(36)
  description String        @db.VarChar(255)
  amount      Decimal       @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(DRAFT)
  dueDate     DateTime?     @map("due_date") @db.Date
  issuedAt    DateTime?     @map("issued_at")
  createdById String        @map("created_by_id") @db.Char(36)
  createdAt   DateTime      @default(now()) @map("created_at")

  transactions Transaction[]

  @@index([issuedToId])
  @@map("invoices")
}

model Refund {
  id            String       @id @default(uuid()) @db.Char(36)
  transactionId String       @map("transaction_id") @db.Char(36)
  amount        Decimal      @db.Decimal(12, 2)
  reason        String       @db.VarChar(500)
  status        RefundStatus @default(REQUESTED)
  requestedById String       @map("requested_by_id") @db.Char(36)
  decidedById   String?      @map("decided_by_id") @db.Char(36)
  decidedAt     DateTime?    @map("decided_at")
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([status])
  @@map("refunds")
}

model SubscriptionPlan {
  id            String         @id @default(uuid()) @db.Char(36)
  name          String         @unique @db.VarChar(60)
  audience      Role
  priceMonthly  Decimal        @map("price_monthly") @db.Decimal(12, 2)
  features      String?        @db.Text
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Char(36)
  userId    String             @map("user_id") @db.Char(36)
  planId    String             @map("plan_id") @db.Char(36)
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @map("starts_at")
  endsAt    DateTime?          @map("ends_at")
  /// PAID (default) | REFERRAL_REWARD | CREDIT_REDEMPTION — promotional periods are never billed.
  source    String             @default("PAID") @db.VarChar(30)
  createdAt DateTime           @default(now()) @map("created_at")

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@map("subscriptions")
}

model PlatformSetting {
  key         String   @id @db.VarChar(64)
  value       String   @db.VarChar(500)
  updatedById String?  @map("updated_by_id") @db.Char(36)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ───────────────────────────── Operations ─────────────────────────────

model MaintenanceRequest {
  id                 String            @id @default(uuid()) @db.Char(36)
  propertyId         String            @map("property_id") @db.Char(36)
  leaseId            String?           @map("lease_id") @db.Char(36)
  raisedById         String            @map("raised_by_id") @db.Char(36)
  landlordId         String            @map("landlord_id") @db.Char(36)
  category           String            @db.VarChar(40)
  title              String            @db.VarChar(150)
  description        String            @db.Text
  priority           Priority          @default(MEDIUM)
  status             MaintenanceStatus @default(OPEN)
  assignedProviderId String?           @map("assigned_provider_id") @db.Char(36)
  serviceCharge      Decimal?          @map("service_charge") @db.Decimal(12, 2)
  providerNote       String?           @map("provider_note") @db.VarChar(500)
  completedAt        DateTime?         @map("completed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  property Property           @relation(fields: [propertyId], references: [id])
  raisedBy User               @relation("MaintenanceRaisedBy", fields: [raisedById], references: [id])
  provider User?              @relation("MaintenanceProvider", fields: [assignedProviderId], references: [id])
  photos   MaintenancePhoto[]

  @@index([landlordId, status])
  @@index([assignedProviderId, status])
  @@index([raisedById])
  @@map("maintenance_requests")
}

model MaintenancePhoto {
  id           String   @id @default(uuid()) @db.Char(36)
  requestId    String   @map("request_id") @db.Char(36)
  filePath     String   @map("file_path") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(60)
  uploadedById String   @map("uploaded_by_id") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("maintenance_photos")
}

model SupportTicket {
  id           String         @id @default(uuid()) @db.Char(36)
  raisedById   String         @map("raised_by_id") @db.Char(36)
  category     TicketCategory
  subject      String         @db.VarChar(150)
  description  String         @db.Text
  priority     Priority       @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  assignedToId String?        @map("assigned_to_id") @db.Char(36)
  propertyId   String?        @map("property_id") @db.Char(36)
  resolvedAt   DateTime?      @map("resolved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  raisedBy   User            @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages   TicketMessage[]

  @@index([raisedById])
  @@index([status, assignedToId])
  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(uuid()) @db.Char(36)
  ticketId  String   @map("ticket_id") @db.Char(36)
  authorId  String   @map("author_id") @db.Char(36)
  body      String   @db.Text
  internal  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model Enquiry {
  id         String        @id @default(uuid()) @db.Char(36)
  propertyId String        @map("property_id") @db.Char(36)
  tenantId   String        @map("tenant_id") @db.Char(36)
  message    String        @db.VarChar(1000)
  status     EnquiryStatus @default(NEW)
  followUpAt DateTime?     @map("follow_up_at")
  notes      String?       @db.VarChar(1000)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([tenantId])
  @@map("enquiries")
}

model PropertyVisit {
  id          String      @id @default(uuid()) @db.Char(36)
  propertyId  String      @map("property_id") @db.Char(36)
  enquiryId   String?     @map("enquiry_id") @db.Char(36)
  agentId     String      @map("agent_id") @db.Char(36)
  tenantId    String?     @map("tenant_id") @db.Char(36)
  scheduledAt DateTime    @map("scheduled_at")
  status      VisitStatus @default(SCHEDULED)
  notes       String?     @db.VarChar(500)
  createdAt   DateTime    @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([agentId, scheduledAt])
  @@map("property_visits")
}

model FraudReport {
  id           String      @id @default(uuid()) @db.Char(36)
  propertyId   String?     @map("property_id") @db.Char(36)
  reportedById String      @map("reported_by_id") @db.Char(36)
  reason       String      @db.VarChar(80)
  details      String      @db.Text
  status       FraudStatus @default(OPEN)
  handledById  String?     @map("handled_by_id") @db.Char(36)
  resolution   String?     @db.VarChar(500)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@map("fraud_reports")
}

model Notification {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  title     String    @db.VarChar(150)
  body      String    @db.VarChar(500)
  link      String?   @db.VarChar(255)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Tenant asks the landlord to share their PAN (for HRA). One row per lease; consent is per lease and revocable.
model PanShareRequest {
  id          String         @id @default(uuid()) @db.Char(36)
  leaseId     String         @unique @map("lease_id") @db.Char(36)
  tenantId    String         @map("tenant_id") @db.Char(36)
  landlordId  String         @map("landlord_id") @db.Char(36)
  status      PanShareStatus @default(PENDING)
  note        String?        @db.VarChar(300)
  requestedAt DateTime       @default(now()) @map("requested_at")
  decidedAt   DateTime?      @map("decided_at")
  decidedById String?        @map("decided_by_id") @db.Char(36)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  lease Lease @relation(fields: [leaseId], references: [id])

  @@index([landlordId, status])
  @@map("pan_share_requests")
}

/// One DigiLocker session. Only what's needed is kept: verified name, DOB, gender, last 4 Aadhaar
/// digits and city/state/PIN. The full Aadhaar number is never stored; the photo is deleted after review.
model IdentityVerification {
  id           String                     @id @default(uuid()) @db.Char(36)
  userId       String                     @map("user_id") @db.Char(36)
  provider     KycProvider
  providerRef  String                     @unique @map("provider_ref") @db.VarChar(80)
  status       IdentityVerificationStatus @default(STARTED)
  name         String?                    @db.VarChar(150)
  dob          String?                    @db.VarChar(20)
  gender       String?                    @db.VarChar(10)
  aadhaarLast4 String?                    @map("aadhaar_last4") @db.VarChar(4)
  city         String?                    @db.VarChar(80)
  state        String?                    @db.VarChar(80)
  pincode      String?                    @db.VarChar(10)
  photoPath    String?                    @map("photo_path") @db.VarChar(255)
  error        String?                    @db.VarChar(300)
  createdAt    DateTime                   @default(now()) @map("created_at")
  completedAt  DateTime?                  @map("completed_at")

  @@index([userId, createdAt])
  @@map("identity_verifications")
}
