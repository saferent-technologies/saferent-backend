}

/// One clearly labelled charge. Charges are never merged into one unclear amount.
model PricingCharge {
  id        String           @id @default(uuid()) @db.Char(36)
  pricingId String           @map("pricing_id") @db.Char(36)
  kind      ChargeKind
  label     String           @db.VarChar(80)
  billing   ChargeBilling
  amount    Decimal?         @db.Decimal(12, 2)
  frequency ChargeFrequency?
  notes     String?          @db.VarChar(255)

  pricing PropertyPricing @relation(fields: [pricingId], references: [id], onDelete: Cascade)

  @@unique([pricingId, kind, label])
  @@map("pricing_charges")
}

model PropertyImage {
  id           String        @id @default(uuid()) @db.Char(36)
  propertyId   String        @map("property_id") @db.Char(36)
  unitId       String?       @map("unit_id") @db.Char(36)
  roomId       String?       @map("room_id") @db.Char(36)
  inspectionId String?       @map("inspection_id") @db.Char(36)
  category     ImageCategory @default(OTHER)
  /// Which room of that category the photo shows, e.g. BEDROOM + slot 2 = "Bedroom 2". Null for general photos.
  slot         Int?
  displayOrder Int           @default(0) @map("display_order")
  filePath     String        @map("file_path") @db.VarChar(255)
  mimeType     String        @map("mime_type") @db.VarChar(60)
  status       ReviewStatus  @default(PENDING)
  reviewedById String?       @map("reviewed_by_id") @db.Char(36)
  uploadedById String        @map("uploaded_by_id") @db.Char(36)
  createdAt    DateTime      @default(now()) @map("created_at")

  property   Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit       PropertyUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  room       PropertyRoom?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  inspection PropertyInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([propertyId, displayOrder])
  @@map("property_images")
}

/// Private by default. Files are only streamed through authorized endpoints.
/// Property / unit documents. Private by default; tenants see a document only when it is shared AND it
/// belongs to their property (property-level) or their own flat / room / bed. Replacing a file adds a new
/// version (same group_id) and keeps the old one; deleting archives.
model PropertyDocument {
  id              String       @id @default(uuid()) @db.Char(36)
  code            String       @unique @db.VarChar(20)
  propertyId      String       @map("property_id") @db.Char(36)
  unitId          String?      @map("unit_id") @db.Char(36)
  roomId          String?      @map("room_id") @db.Char(36)
  bedId           String?      @map("bed_id") @db.Char(36)
  docType         DocumentType @map("doc_type")
  /// Name for "Other" documents (any text), or an optional title for the others.
  customName      String?      @map("custom_name") @db.VarChar(150)
  description     String?      @db.VarChar(1000)
  documentDate    DateTime?    @map("document_date") @db.Date
  expiryDate      DateTime?    @map("expiry_date") @db.Date
  sharedWithTenant Boolean     @default(false) @map("shared_with_tenant")
  /// First time tenants were notified about this document (no repeat notifications).
  sharedNotifiedAt DateTime?   @map("shared_notified_at")
  /// Only ownership-type documents go to SafeRent's verification queue.
  needsVerification Boolean    @default(true) @map("needs_verification")
  /// Versions: all versions share group_id; exactly one is current.
  groupId         String?      @map("group_id") @db.Char(36)
  version         Int          @default(1)
  isCurrent       Boolean      @default(true) @map("is_current")
  archivedAt      DateTime?    @map("archived_at")
  archivedById    String?      @map("archived_by_id") @db.Char(36)
  fileSize        Int?         @map("file_size")
  filePath        String       @map("file_path") @db.VarChar(255)
  originalName    String       @map("original_name") @db.VarChar(200)
  mimeType        String       @map("mime_type") @db.VarChar(60)
  status          ReviewStatus @default(PENDING)
  verifiedById    String?      @map("verified_by_id") @db.Char(36)
  verifiedAt      DateTime?    @map("verified_at")
  rejectionReason String?      @map("rejection_reason") @db.VarChar(500)
  uploadedById    String       @map("uploaded_by_id") @db.Char(36)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([propertyId, isCurrent, archivedAt])
  @@index([groupId, version])
  @@map("property_documents")
}

enum DocumentRequestStatus {
  PENDING
  IN_PROGRESS
  FULFILLED
  REJECTED
  CANCELLED
}

/// A tenant asks their landlord for a document; fulfilled by uploading + sharing it.
model DocumentRequest {
  id               String                @id @default(uuid()) @db.Char(36)
  code             String                @unique @db.VarChar(20)
  tenantId         String                @map("tenant_id") @db.Char(36)
  landlordId       String                @map("landlord_id") @db.Char(36)
  leaseId          String                @map("lease_id") @db.Char(36)
  propertyId       String                @map("property_id") @db.Char(36)
  unitId           String?               @map("unit_id") @db.Char(36)
  bedId            String?               @map("bed_id") @db.Char(36)
  documentName     String                @map("document_name") @db.VarChar(150)
  reason           String?               @db.VarChar(1000)
  status           DocumentRequestStatus @default(PENDING)
  linkedDocumentId String?               @map("linked_document_id") @db.Char(36)
  rejectionReason  String?               @map("rejection_reason") @db.VarChar(500)
  respondedById    String?               @map("responded_by_id") @db.Char(36)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([propertyId, status])
  @@index([tenantId, status])
  @@index([landlordId, status])
  @@map("document_requests")
}

model PropertyAssignment {
  id          String         @id @default(uuid()) @db.Char(36)
  propertyId  String         @map("property_id") @db.Char(36)
  userId      String         @map("user_id") @db.Char(36)
  type        AssignmentType
  createdById String         @map("created_by_id") @db.Char(36)
