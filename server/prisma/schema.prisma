model PropertyBed {
  id                 String             @id @default(uuid()) @db.Char(36)
  code               String             @unique @db.VarChar(20)
  roomId             String             @map("room_id") @db.Char(36)
  propertyId         String             @map("property_id") @db.Char(36)
  bedNumber          String             @map("bed_number") @db.VarChar(20)
  rent               Decimal?           @db.Decimal(12, 2)
