model PropertyPolicy {
  propertyId                String     @id @map("property_id") @db.Char(36)
  guestsAllowed             Disclosure @default(NOT_DISCLOSED) @map("guests_allowed")
  overnightGuestsAllowed    Disclosure @default(NOT_DISCLOSED) @map("overnight_guests_allowed")
