// ───────────────────────────── Identity & RBAC ─────────────────────────────

/// Every SafeRent account. firebase_uid links the row to the Firebase Authentication user (no duplicates).
model User {
  id                 String        @id @default(uuid()) @db.Char(36)
  firebaseUid        String        @unique @map("firebase_uid") @db.VarChar(128)
  fullName           String        @map("full_name") @db.VarChar(120)
  email              String?       @unique @db.VarChar(254)
  pendingEmail       String?       @map("pending_email") @db.VarChar(254)
  phoneNumber        String?       @unique @map("phone_number") @db.VarChar(20)
  profileImage       String?       @map("profile_image") @db.VarChar(255)
  role               Role
  accountStatus      AccountStatus @default(ACTIVE) @map("account_status")
  isFounder          Boolean       @default(false) @map("is_founder")
  emailVerified      Boolean       @default(false) @map("email_verified")
  phoneVerified      Boolean       @default(false) @map("phone_verified")
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?     @map("password_changed_at")
  lastLoginAt        DateTime?     @map("last_login_at")
  createdById        String?       @map("created_by_id") @db.Char(36)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  otpChallenge    OtpChallenge?
  session         AuthSession?
  permissions     UserPermission[]
  extraRoles      UserRole[]
  landlordProfile LandlordProfile?
  tenantProfile   TenantProfile?
  agentProfile    AgentProfile?
  providerProfile ServiceProviderProfile?
  auditLogs       AuditLog[]

  ownedProperties     Property[]           @relation("PropertyOwner")
  assignments         PropertyAssignment[] @relation("AssignmentUser")
  applications        RentalApplication[]  @relation("ApplicationTenant")
  tenantLeases        Lease[]              @relation("LeaseTenant")
  landlordLeases      Lease[]              @relation("LeaseLandlord")
  raisedMaintenance   MaintenanceRequest[] @relation("MaintenanceRaisedBy")
  assignedMaintenance MaintenanceRequest[] @relation("MaintenanceProvider")
  tickets             SupportTicket[]      @relation("TicketRaisedBy")
  assignedTickets     SupportTicket[]      @relation("TicketAssignee")
  notifications       Notification[]

  @@index([role, accountStatus])
  @@map("users")
}

/// Additional roles held by one account (e.g. a LANDLORD who is also a TENANT). users.role stays the
/// primary role; only customer roles (LANDLORD, TENANT, PROPERTY_AGENT, SERVICE_PROVIDER) can be added here.
model UserRole {
  userId      String   @map("user_id") @db.Char(36)
  role        Role
  grantedById String?  @map("granted_by_id") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model RoleDefinition {
  key         String           @id @db.VarChar(32)
  name        String           @db.VarChar(60)
  description String           @db.VarChar(255)
  rank        Int
  isStaff     Boolean          @map("is_staff")
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  key         String           @id @db.VarChar(64)
  category    String           @db.VarChar(40)
  description String           @db.VarChar(255)
  reserved    Boolean          @default(false)
  roles       RolePermission[]
  users       UserPermission[]

  @@map("permissions")
}

model RolePermission {
  role          String          @db.VarChar(32)
  permissionKey String          @map("permission_key") @db.VarChar(64)
  scope         PermissionScope

  roleDef    RoleDefinition @relation(fields: [role], references: [key], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([role, permissionKey])
  @@map("role_permissions")
}

/// Individual overrides: granted=true adds a permission, granted=false removes one the role gives.
model UserPermission {
  userId        String          @map("user_id") @db.Char(36)
  permissionKey String          @map("permission_key") @db.VarChar(64)
  granted       Boolean
  scope         PermissionScope @default(OWN)
  grantedById   String          @map("granted_by_id") @db.Char(36)
  createdAt     DateTime        @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([userId, permissionKey])
  @@map("user_permissions")
}

// ───────────────────────────── Auth support ─────────────────────────────

model OtpChallenge {
  userId            String    @id @map("user_id") @db.Char(36)
  challengeId       String    @unique @map("challenge_id") @db.Char(36)
  otpHash           String    @map("otp_hash") @db.Char(64)
  authTime          Int       @map("auth_time")
  attempts          Int       @default(0)
  maxAttempts       Int       @map("max_attempts")
  consumed          Boolean   @default(false)
  expiresAt         DateTime  @map("expires_at")
  resendAvailableAt DateTime  @map("resend_available_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  consumedAt        DateTime? @map("consumed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_challenges")
}

/// Proof that the second factor (email OTP or phone OTP) was completed for ONE Firebase sign-in.
model AuthSession {
  userId     String        @id @map("user_id") @db.Char(36)
  authTime   Int           @map("auth_time")
  method     SessionMethod
  verifiedAt DateTime      @default(now()) @map("verified_at")
  expiresAt  DateTime      @map("expires_at")
  revoked    Boolean       @default(false)
  revokedAt  DateTime?     @map("revoked_at")
  ip         String?       @db.VarChar(64)
  userAgent  String?       @map("user_agent") @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model RateLimit {
  key         String   @id @map("rate_key") @db.Char(64)
  count       Int
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limits")
}

/// security_audit_logs: sign-ins, OTPs, password/email/phone changes, permission denials.
model AuditLog {
  id          BigInt       @id @default(autoincrement())
  userId      String?      @map("user_id") @db.Char(36)
  firebaseUid String?      @map("firebase_uid") @db.VarChar(128)
  action      String       @db.VarChar(64)
  outcome     AuditOutcome
  reason      String?      @db.VarChar(64)
  email       String?      @db.VarChar(254)
  ip          String?      @db.VarChar(64)
  userAgent   String?      @map("user_agent") @db.VarChar(300)
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("security_audit_logs")
}

/// admin_activity_logs: who changed what (users, roles, permissions, finance, moderation).
model AdminActivityLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String   @map("actor_id") @db.Char(36)
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(40)
  targetId   String?  @map("target_id") @db.VarChar(64)
  changes    Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_activity_logs")
}

model SystemLock {
  name      String   @id @db.VarChar(64)
  status    String   @db.VarChar(32)
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_locks")
}

// ───────────────────────────── Role profiles ─────────────────────────────

model LandlordProfile {
  userId       String   @id @map("user_id") @db.Char(36)
  businessName String?  @map("business_name") @db.VarChar(120)
  address      String?  @db.VarChar(255)
  city         String?  @db.VarChar(80)
  state        String?  @db.VarChar(80)
  pincode      String?  @db.VarChar(10)
  kycStatus    ReviewStatus @default(PENDING) @map("kyc_status")
  kycNote      String?  @map("kyc_note") @db.VarChar(500)
  kycReviewedById String? @map("kyc_reviewed_by_id") @db.Char(36)
  kycReviewedAt DateTime? @map("kyc_reviewed_at")
  /// Owner's PAN. Never returned whole except on receipts the owner consented to (see PanShareRequest).
  pan          String?  @db.VarChar(10)
  /// Owner opted in to show the PAN on receipts for ALL their tenants (HRA). Default off.
  panShareAll  Boolean  @default(false) @map("pan_share_all")
  panShareAllAt DateTime? @map("pan_share_all_at")
  /// Owner verification: when the owner sent DigiLocker + selfie for review (null = not submitted yet).
  kycSubmittedAt DateTime? @map("kyc_submitted_at")
  /// Live selfie, compared by staff with the DigiLocker photo.
  selfiePath   String?  @map("selfie_path") @db.VarChar(255)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("landlord_profiles")
}

model TenantProfile {
  userId                String    @id @map("user_id") @db.Char(36)
  occupation            String?   @db.VarChar(80)
  employer              String?   @db.VarChar(120)
  currentCity           String?   @map("current_city") @db.VarChar(80)
  familySize            Int?      @map("family_size")
  preferredMoveIn       DateTime? @map("preferred_move_in") @db.Date
  emergencyContactName  String?   @map("emergency_contact_name") @db.VarChar(120)
  emergencyContactPhone String?   @map("emergency_contact_phone") @db.VarChar(20)
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

model AgentProfile {
  userId          String   @id @map("user_id") @db.Char(36)
  agencyName      String?  @map("agency_name") @db.VarChar(120)
  licenseNumber   String?  @map("license_number") @db.VarChar(60)
  serviceAreas    String?  @map("service_areas") @db.VarChar(255)
  experienceYears Int?     @map("experience_years")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model ServiceProviderProfile {
  userId       String   @id @map("user_id") @db.Char(36)
  businessName String?  @map("business_name") @db.VarChar(120)
  categories   String?  @db.VarChar(255)
  serviceAreas String?  @map("service_areas") @db.VarChar(255)
  available    Boolean  @default(true)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("service_provider_profiles")
}

// ───────────────────────────── Properties ─────────────────────────────

model PropertyTypeDefinition {
  key       String           @id @db.VarChar(40)
  category  PropertyCategory
  label     String           @db.VarChar(80)
  /// MULTI_UNIT | VILLA | SINGLE_UNIT | DUPLEX | ROOMS_BEDS
  structure String           @db.VarChar(20)
  active    Boolean          @default(true)
  sortOrder Int              @default(0) @map("sort_order")
  /// Field definitions used by the API for validation and by every client to render forms.
  schema    Json
  updatedAt DateTime         @updatedAt @map("updated_at")

  properties Property[]

  @@map("property_types")
}

model AmenityDefinition {
  key        String   @id @db.VarChar(40)
  label      String   @db.VarChar(80)
  /// JSON array of PropertyCategory values this amenity applies to.
  categories Json
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")

  @@map("amenities")
}

/// Transactional counters for readable IDs (SR-PROP-000001 …). Incremented with a row lock.
model IdCounter {
  name  String @id @db.VarChar(20)
  value BigInt

  @@map("id_counters")
}

model Property {
  id                 String             @id @default(uuid()) @db.Char(36)
  code               String             @unique @db.VarChar(20)
  ownerId            String             @map("owner_id") @db.Char(36)
  createdById        String             @map("created_by_id") @db.Char(36)
  category           PropertyCategory
  propertyTypeKey    String             @map("property_type") @db.VarChar(40)
  listingType        ListingType        @default(RENT) @map("listing_type")
  title              String?            @db.VarChar(150)
  description        String?            @db.Text
  /// Apartment / project / PG / house name.
  name               String?            @db.VarChar(150)
  addressLine        String?            @map("address_line") @db.VarChar(255)
  locality           String?            @db.VarChar(120)
  city               String?            @db.VarChar(80)
  state              String?            @db.VarChar(80)
  country            String             @default("India") @db.VarChar(60)
  pincode            String?            @db.VarChar(10)
  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  totalFloors        Int?               @map("total_floors")
  totalUnits         Int?               @map("total_units")
  /// Type-specific building fields, validated against property_types.schema.
  attributes         Json?
  activeStatus       ActiveStatus       @default(ACTIVE) @map("active_status")
  publicationStatus  PublicationStatus  @default(DRAFT) @map("publication_status")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  moderationNote     String?            @map("moderation_note") @db.VarChar(500)
  reviewedById       String?            @map("reviewed_by_id") @db.Char(36)
  reviewedAt         DateTime?          @map("reviewed_at")
  submittedAt        DateTime?          @map("submitted_at")
  publishedAt        DateTime?          @map("published_at")
  archivedAt         DateTime?          @map("archived_at")
  wizardStep         Int                @default(1) @map("wizard_step")
  /// Backend-calculated aggregates (refreshed after every change).
  completenessScore  Int                @default(0) @map("completeness_score")
  rentFrom           Decimal?           @map("rent_from") @db.Decimal(12, 2)
  rentTo             Decimal?           @map("rent_to") @db.Decimal(12, 2)
  availableCount     Int                @default(0) @map("available_count")
  occupiedCount      Int                @default(0) @map("occupied_count")
  /// Optimistic concurrency: incremented on every update.
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  owner        User                   @relation("PropertyOwner", fields: [ownerId], references: [id])
  type         PropertyTypeDefinition @relation(fields: [propertyTypeKey], references: [key])
  units        PropertyUnit[]
  rooms        PropertyRoom[]
  utilities    PropertyUtility[]
  policy       PropertyPolicy?
  amenities    PropertyAmenity[]
  pricing      PropertyPricing[]
  images       PropertyImage[]
  documents    PropertyDocument[]
  assignments  PropertyAssignment[]
  inspections  PropertyInspection[]
  history      PropertyStatusHistory[]
  applications RentalApplication[]
  leases       Lease[]
  invitations  TenantInvitation[]
  reviews      RentalReview[]
  maintenance  MaintenanceRequest[]
  enquiries    Enquiry[]
  visits       PropertyVisit[]

  @@index([ownerId, publicationStatus])
  @@index([publicationStatus, activeStatus, city])
  @@index([propertyTypeKey])
  @@index([rentFrom])
  @@map("properties")
}

/// A rentable unit inside a property: a flat, a villa, a house, a duplex, a commercial space or a plot.
model PropertyUnit {
  id                 String             @id @default(uuid()) @db.Char(36)
  code               String             @unique @db.VarChar(20)
  propertyId         String             @map("property_id") @db.Char(36)
  kind               UnitKind
  name               String?            @db.VarChar(120)
  unitNumber         String?            @map("unit_number") @db.VarChar(30)
  floorNumber        Int?               @map("floor_number")
  bhkType            String?            @map("bhk_type") @db.VarChar(20)
  bedrooms           Int?
  bathrooms          Int?
  balconies          Int?
  kitchenCount       Int?               @map("kitchen_count")
  livingRoomCount    Int?               @map("living_room_count")
  builtUpArea        Decimal?           @map("built_up_area") @db.Decimal(12, 2)
  carpetArea         Decimal?           @map("carpet_area") @db.Decimal(12, 2)
  plotArea           Decimal?           @map("plot_area") @db.Decimal(12, 2)
  furnishing         Furnishing         @default(NOT_DISCLOSED)
  configuration      String?            @db.VarChar(20)
  totalFloors        Int?               @map("total_floors")
  parkingCapacity    Int?               @map("parking_capacity")
  parkingDetails     String?            @map("parking_details") @db.VarChar(255)
  attributes         Json?
  availableFrom      DateTime?          @map("available_from") @db.Date
