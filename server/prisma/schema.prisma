// SafeRent — MySQL schema (Prisma ORM)
// Firebase is used ONLY for authentication (users.firebase_uid links the two).
//   npm run db:migrate     -> create/update tables in your local MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE_ADMIN
  PROPERTY_MANAGER
  SUPPORT
  MODERATOR
  VIEWER
  LANDLORD
  TENANT
  PROPERTY_AGENT
  SERVICE_PROVIDER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// ALL = every record, ASSIGNED = records assigned to the user, OWN = records the user owns / is party to
enum PermissionScope {
  OWN
  ASSIGNED
  ALL
}

enum SessionMethod {
  EMAIL_OTP
  PHONE_OTP
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum ListingType {
