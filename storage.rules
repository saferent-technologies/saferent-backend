rules_version = '2';
// Property images and private documents are stored by the SafeRent API (server/src/lib/uploads.ts)
// and only streamed after an authorization check. Clients never access Firebase Storage directly.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
