# Copy to web/.env.local and fill in from:
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration
# These values are PUBLIC identifiers (they ship to the browser). Security comes from
# Firebase Auth and the SafeRent API — never from hiding these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# SafeRent API (server/). Leave empty in development — Vite forwards /api to http://localhost:4000.
# In production set it to your API URL, e.g. https://api.saferenttechnologies.com
VITE_API_URL=

# Firebase App Check (reCAPTCHA Enterprise site key) — optional for local development
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only: App Check debug token
VITE_APPCHECK_DEBUG_TOKEN=
